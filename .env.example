DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
AUTH_SECRET=generate-a-long-random-secret-for-nextauth
AUTH_URL=http://localhost:3000
# Dedicated admin login. Admins do not use public employer/candidate signup.
ADMIN_NAME=Your Admin Name
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=set-a-strong-password-here
# Google sign-in is optional. Leave both Google values empty to hide/disable Google auth.
# If you enable it, add the redirect URI for the address you use in the browser.
# Localhost:
# http://localhost:3000/api/auth/callback/google
# LAN/dev-machine URL example:
# http://192.168.56.1:3000/api/auth/callback/google
# Supported variable names: AUTH_GOOGLE_ID/AUTH_GOOGLE_SECRET or GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
